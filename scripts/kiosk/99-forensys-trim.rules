# ForenSys - Habilitar TRIM/UNMAP para adaptadores NVMe USB con chip Realtek RTL9210
#
# Por qué existe este archivo:
#   El kernel de Linux desactiva TRIM por USB de forma global como medida de seguridad
#   para evitar daños con chips USB baratos con firmware defectuoso.
#   El chip RTL9210 de Realtek soporta TRIM/UNMAP de forma confiable vía UASP,
#   pero Linux lo bloquea estableciendo su provisioning_mode en "full" (cero TRIM).
#
# Efecto:
#   Obliga al kernel a usar "unmap" (SCSI UNMAP) para estos chips en específico.
#
# PIDs conocidos del chip Realtek RTL9210:
#   0bda:9210, 0bda:9211, 0bda:9215, 0bda:9216

ACTION=="add|change", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="9210", SUBSYSTEM=="scsi_disk", ATTR{provisioning_mode}="unmap"
ACTION=="add|change", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="9211", SUBSYSTEM=="scsi_disk", ATTR{provisioning_mode}="unmap"
ACTION=="add|change", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="9215", SUBSYSTEM=="scsi_disk", ATTR{provisioning_mode}="unmap"
ACTION=="add|change", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="9216", SUBSYSTEM=="scsi_disk", ATTR{provisioning_mode}="unmap"
